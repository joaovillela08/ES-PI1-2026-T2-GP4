#================== validar integridade ========


def validar_integridade():

    votos_urna = sum(
        d["votos"] for d in candidatos.values()
    )

    eleitores_votaram = sum(
        1 for e in eleitores
        if e["ja_votou"]
    )

    print("\n--- VALIDAÇÃO DE INTEGRIDADE ---")

    print("Votos registrados:", votos_urna)
    print("Eleitores com status 'Já votou':", eleitores_votaram)

    if votos_urna == eleitores_votaram:
        print("Integridade validada!")
    else:
        print("Inconsistência encontrada!")










