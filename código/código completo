# ================= AUXILIARES =================
def gerar_protocolo(numero_candidato):

    letras = ''.join(
        random.choices(string.ascii_uppercase, k=2)
    )

    numeros = ''.join(
        random.choices(string.digits, k=5)
    )

    return f"V{letras}26{numero_candidato}{numeros}"


def gerar_codigo(nome):

    partes = nome.strip().upper().split()

    # Pega as 2 primeiras letras do primeiro nome
    primeira_parte = partes[0][:2]

    # Pega a primeira letra do segundo nome
    if len(partes) > 1:
        segunda_parte = partes[1][0]
    else:
        segunda_parte = "X"  # caso a pessoa tenha apenas um nome

    # Gera 4 números aleatórios
    numeros = ''.join(random.choices(string.digits, k=4))

    # Junta tudo
    codigo = primeira_parte + segunda_parte + numeros

    return codigo


# ================= VALIDAÇÕES =================

def validar_cpf(cpf):

    cpf = cpf.replace(".", "").replace("-", "").strip()

    if not cpf.isdigit() or len(cpf) != 11:
        return False

    if cpf == cpf[0] * 11:
        return False

    for qtd in [9, 10]:

        soma = sum(
            int(cpf[i]) * ((qtd + 1) - i)
            for i in range(qtd)
        )

        digito = 0 if soma % 11 < 2 else 11 - soma % 11

        if digito != int(cpf[qtd]):
            return False

    return True


def validar_titulo(titulo):

    titulo = titulo.strip()

    if not titulo.isdigit() or len(titulo) != 12:
        return False

    numero = titulo[:8]
    uf = titulo[8:10]

    pesos = [2, 3, 4, 5, 6, 7, 8, 9]

    soma = sum(int(numero[i]) * pesos[i] for i in range(8))

    dv1 = 0 if soma % 11 == 10 else soma % 11

    soma = int(uf[0]) * 7 + int(uf[1]) * 8 + dv1 * 9

    dv2 = 0 if soma % 11 == 10 else soma % 11



# ================= CRIPTOGRAFIA =================

caracteres = " " + string.punctuation + string.digits + string.ascii_letters
N = len(caracteres)

# Chave padrão (matriz 2x2)
chave = [[3, 5], [2, 7]]


def matriz_valida(m):
    det = (m[0][0] * m[1][1] - m[0][1] * m[1][0]) % N
    try:
        pow(det, -1, N)
        return True
    except:
        return False


# ---- CRIPTOGRAFAR ----
# O parâmetro 'm' tem valor padrão = chave global,
# então pode ser chamado como criptografar(texto) ou criptografar(texto, outra_chave)
def criptografar(mensagem, m=None):
    if m is None:
        m = chave
    if len(mensagem) % 2 != 0:
        mensagem += " "
    resultado = ""
    for i in range(0, len(mensagem), 2):
        p1, p2 = caracteres.index(mensagem[i]), caracteres.index(mensagem[i+1])
        resultado += caracteres[(m[0][0]*p1 + m[0][1]*p2) % N]
        resultado += caracteres[(m[1][0]*p1 + m[1][1]*p2) % N]
    return resultado


# ---- DESCRIPTOGRAFAR ----
def descriptografar(cifrado, m=None):
    if m is None:
        m = chave
    det = (m[0][0]*m[1][1] - m[0][1]*m[1][0]) % N
    d   = pow(det, -1, N)
    inv = [[ d * m[1][1] % N, (-d * m[0][1]) % N],
           [(-d * m[1][0]) % N,  d * m[0][0] % N]]
    return criptografar(cifrado, inv)


