#================== estastitica de comparecimento ========


def estatistica_comparecimento():

    total = len(eleitores)

    votaram = sum(
        1 for e in eleitores
        if e["ja_votou"]
    )

    percentual = (votaram / total * 100) if total else 0

    print("\n--- ESTATÍSTICA DE COMPARECIMENTO ---")

    print("Eleitores aptos:", total)
    print("Compareceram:", votaram)
    print(f"Percentual: {percentual:.2f}%")




#================== votos por partido ========



def votos_partido():

    partidos = {}

    for d in candidatos.values():

        partido = d["partido"]

        partidos[partido] = partidos.get(partido, 0) + d["votos"]

    print("\n--- VOTOS POR PARTIDO ---")

    for partido, votos in partidos.items():
