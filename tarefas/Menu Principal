def menu_principal():

    while True:

        print("""
===== SISTEMA ELEITORAL =====
1 - Gerenciamento
2 - Votação
0 - Sair
""")

        op = input("Escolha: ")

        if op == "1":
            menu_gerenciamento()

        elif op == "2":
            menu_votacao()

        elif op == "0":
            print("Encerrando sistema...")
            break

        else:
            print("Opção inválida.")
