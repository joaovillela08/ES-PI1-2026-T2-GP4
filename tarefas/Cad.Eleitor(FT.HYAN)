def cadastrar_eleitor():

    print("\n--- CADASTRO DE ELEITOR ---")

    nome = input("Nome completo: ")
    cpf = input("CPF: ")
    titulo = input("Título de eleitor: ")

    if not validar_cpf(cpf):
        print("CPF inválido!")
        return

    if not validar_titulo(titulo):
        print("Título inválido!")
        return

    cpf = cpf.replace(".", "").replace("-", "").strip()

    mesario = input("Atuará como mesário? (S/N): ").upper()

    if mesario not in ["S", "N"]:
        print("Opção inválida!")
        return

    mesario_db = 1 if mesario == "S" else 0

    chave = gerar_codigo(nome)

    conexao = conectar()
    cursor = conexao.cursor()

    cursor.execute("""
                   SELECT *
                   FROM eleitores
                   WHERE cpf = %s
                      OR titulo_eleitor = %s
                   """, (cpf, titulo.strip()))

    eleitor_existente = cursor.fetchone()

    if eleitor_existente:
        print("\nErro: eleitor já cadastrado!")

        cursor.close()
        conexao.close()

        return

    cursor.execute("""
                   INSERT INTO eleitores
                       (nome, cpf, titulo_eleitor, mesario, chave_acesso, status_voto)
                   VALUES (%s, %s, %s, %s, %s, %s)
                   """, (
                       nome,
                       cpf,
                       titulo.strip(),
                       mesario_db,
                       chave,
                       False
                   ))

    conexao.commit()

    cursor.close()
    conexao.close()

    print("\nCadastro realizado com sucesso!")
    print("Chave de acesso:", chave)
