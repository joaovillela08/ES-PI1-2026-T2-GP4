def boletim_urna():

    print("\n--- BOLETIM DE URNA ---")

    ordenados = sorted(
        candidatos.items(),
        key=lambda x: x[1]["nome"]
    )

    for numero, dados in ordenados:

        print(
            f"{dados['nome']} "
            f"({numero}) - "
            f"{dados['partido']} "
            f"| {dados['votos']} votos"
        )
