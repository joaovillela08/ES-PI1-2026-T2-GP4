def gerar_codigo(nome):

    partes = nome.strip().upper().split()

    # Pega as 2 primeiras letras do primeiro nome
    primeira_parte = partes[0][:2]

    # Pega a primeira letra do segundo nome
    if len(partes) > 1:
        segunda_parte = partes[1][0]
    else:
        segunda_parte = "X"  # caso a pessoa tenha apenas um nome

    # Gera 4 números aleatórios
    numeros = ''.join(random.choices(string.digits, k=4))

    # Junta tudo
    codigo = primeira_parte + segunda_parte + numeros

    return codigo
