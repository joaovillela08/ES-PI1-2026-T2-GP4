def validar_cpf(cpf):

    cpf = cpf.replace(".", "").replace("-", "").strip()

    if not cpf.isdigit() or len(cpf) != 11:
        return False

    if cpf == cpf[0] * 11:
        return False

    for qtd in [9, 10]:

        soma = sum(
            int(cpf[i]) * ((qtd + 1) - i)
            for i in range(qtd)
        )

        digito = 0 if soma % 11 < 2 else 11 - soma % 11

        if digito != int(cpf[qtd]):
            return False

    return True
