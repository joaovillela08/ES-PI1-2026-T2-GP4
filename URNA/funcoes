def menu_urna():
    if not zeresima_realizada:
        print("Erro: Zerésima não realizada.")
        return

    if not votacao_aberta:
        print("Sistema fechado.")
        return

    print("""
--- URNA ---
1 - Votar
2 - Encerrar Sistema
0 - Voltar
""")

    op = input("Escolha: ")

    if op == "1":
        realizar_voto()
        menu_urna()

    elif op == "2":
        encerrar_sistema()
        if votacao_aberta:  # só volta ao menu se ainda estiver aberta
            menu_urna()

    elif op == "0":
        return

    else:
        print("Opção inválida.")
        menu_urna()

def boletim_urna():

    print("\n--- BOLETIM DE URNA ---")

    ordenados = sorted(
        candidatos.items(),
        key=lambda x: x[1]["nome"]
    )

    for numero, dados in ordenados:

        print(
            f"{dados['nome']} "
            f"({numero}) - "
            f"{dados['partido']} "
            f"| {dados['votos']} votos"
        )
