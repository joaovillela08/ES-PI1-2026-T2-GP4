def boletim_urna():

    print("\n--- BOLETIM DE URNA ---")

    ordenados = sorted(
        candidatos.items(),
        key=lambda x: x[1]["nome"]
    )

    for numero, dados in ordenados:

        print(
            f"{dados['nome']} "
            f"({numero}) - "
            f"{dados['partido']} "
            f"| {dados['votos']} votos"
        )

    numero, vencedor = max(
        candidatos.items(),
        key=lambda x: x[1]["votos"]
    )

    print("\n--- VENCEDOR ---")

    print("Nome:", vencedor["nome"])
    print("Número:", numero)
    print("Partido:", vencedor["partido"])
    print("Votos:", vencedor["votos"])

def estatistica_comparecimento():

    total = len(eleitores)

    votaram = sum(
        1 for e in eleitores
        if e["ja_votou"]
    )

    percentual = (votaram / total * 100) if total else 0

    print("\n--- ESTATÍSTICA DE COMPARECIMENTO ---")

    print("Eleitores aptos:", total)
    print("Compareceram:", votaram)
    print(f"Percentual: {percentual:.2f}%")



