import string

# ---- 1. ALFABETO ----
caracteres = " " + string.punctuation + string.digits + string.ascii_letters
N = len(caracteres)

# ---- 2. CHAVE (matriz 2x2 como lista simples) ----
chave = [[3, 5], [2, 7]]

# ---- 3. VALIDAÇÃO ----
def matriz_valida(m):
    det = (m[0][0] * m[1][1] - m[0][1] * m[1][0]) % N
    try:
        pow(det, -1, N)
        return True
    except:
        return False

# ---- 4. CRIPTOGRAFAR ----
def criptografar(mensagem, m):
    if len(mensagem) % 2 != 0:
        mensagem += " "
    resultado = ""
    for i in range(0, len(mensagem), 2):
        p1, p2 = caracteres.index(mensagem[i]), caracteres.index(mensagem[i+1])
        resultado += caracteres[(m[0][0]*p1 + m[0][1]*p2) % N]
        resultado += caracteres[(m[1][0]*p1 + m[1][1]*p2) % N]
    return resultado

# ---- 5. DESCRIPTOGRAFAR ----
def descriptografar(cifrado, m):
    det = (m[0][0]*m[1][1] - m[0][1]*m[1][0]) % N
    d   = pow(det, -1, N)
    inv = [[ d * m[1][1] % N, (-d * m[0][1]) % N],
           [(-d * m[1][0]) % N,  d * m[0][0] % N]]
    return criptografar(cifrado, inv)

# ---- 6. MAIN ----
if not matriz_valida(chave):
    print("Matriz inválida!")
else:
    msg    = input("Mensagem para criptografar: ")
    cripto = criptografar(msg, chave)
    print(f"Criptografada:   {cripto}")

    texto  = input("Mensagem para descriptografar: ")
    print(f"Descriptografada: {descriptografar(texto, chave)}")
